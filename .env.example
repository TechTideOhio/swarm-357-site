# Landing 0.2.2 — compatible with techtide-swarm 0.2.2
# Public API base for read-only client fetches (health, agents, status)
# Local: http://localhost:8000
# Production Railway: https://swarm357be.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only (BFF) — never NEXT_PUBLIC_*. Used by app/api/swarm/run/route.ts
SWARM_API_KEY=
# Optional override if API URL differs from NEXT_PUBLIC_API_URL for the BFF
# SWARM_API_URL=https://swarm357be.up.railway.app
